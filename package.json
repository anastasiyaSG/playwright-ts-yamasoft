{\n  \"name\": \"roadtrippers-playwright-ts\",\n  \"version\": \"1.0.0\",\n  \"description\": \"TypeScript Playwright test automation for Roadtrippers\",\n  \"scripts\": {\n    \"test\": \"playwright test\",\n    \"test:debug\": \"playwright test --debug\",\n    \"test:ui\": \"playwright test --ui\",\n    \"test:headed\": \"playwright test --headed\",\n    \"test:report\": \"playwright show-report\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"^16.3.1\"\n  },\n  \"devDependencies\": {\n    \"@playwright/test\": \"^1.40.0\",\n    \"@types/node\": \"^20.10.0\",\n    \"typescript\": \"^5.3.3\"\n  }\n}\n